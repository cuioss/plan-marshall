def _version_key(name: str) -> tuple[int, ...]:
    """Order a version directory name by its numeric parts.

    Same digit-run semantics as ``marketplace_bundles._version_sort_key``:
    ``0.1.1069`` -> ``(0, 1, 1069)``; a name with no digits yields the empty
    tuple and sorts lowest. Spelled here rather than imported because the
    generated executor is bootstrap-free and must resolve notations before any
    marketplace module is importable.
    """
    import re

    return tuple(int(part) for part in re.findall(r'\d+', name))


def _relative_script_path(notation: str) -> str:
    """Return the script's path relative to its ``scripts/`` directory.

    The suffix after the LAST ``/scripts/`` segment — not ``{script}.py`` — is
    what identifies the file inside a skill's ``scripts`` directory, and it is
    the same suffix for both deployed shapes:

    - nested: ``.../skills/{skill}/scripts/{suffix}`` (tree, Claude cache);
    - flat:   ``.../{bundle}-{skill}/scripts/{suffix}`` (OpenCode, Antigravity).

    The four script-shared entries that live in a sub-directory (``extension/``,
    ``query/``, ``workflow/``) carry a flat notation name over a nested file, so a
    ``{script}.py`` join makes them unresolvable in the tree and in every install.
    Anchoring on ``/scripts/`` rather than on ``skills/{skill}/scripts/`` is what
    keeps a FLAT-sourced mapping resolvable — the flat shape has no ``skills``
    segment to anchor on.

    ``SCRIPTS`` is consulted defensively: the resolver body is also executed in
    isolation by tests that carry no embedded mapping, and a missing map must
    degrade to the ``{script}.py`` join rather than raise.
    """
    parts = notation.split(':')
    try:
        embedded = SCRIPTS.get(notation)
    except NameError:  # no embedded mapping in this namespace
        embedded = None
    if len(parts) == 3 and embedded:
        idx = embedded.rfind('/scripts/')
        if idx >= 0:
            return embedded[idx + len('/scripts/') :]
    return f'{parts[2]}.py' if len(parts) == 3 else ''


def _tree_probe(notation: str) -> str | None:
    """Resolve ``notation`` to a live ``marketplace/bundles`` tree, or ``None``.

    Walks up from THIS executor file, so the tree is tied to the artifact being
    run: an executor at ``<checkout>/.plan/execute-script.py`` always sees its
    own checkout. This leg runs FIRST for every harness — a live tree beats every
    deployed copy, so a regeneration on a developer machine can never leave the
    executor resolving stale deployed code.
    """
    parts = notation.split(':')
    if len(parts) != 3:
        return None
    bundle, skill = parts[0], parts[1]
    relative = _relative_script_path(notation)
    if not relative:
        return None
    try:
        executor_file = Path(__file__).resolve()
    except (OSError, ValueError, NameError):
        return None
    for parent in (executor_file.parent, *executor_file.parents):
        try:
            candidate = parent / 'marketplace' / 'bundles' / bundle / 'skills' / skill / 'scripts' / relative
            if candidate.is_file():
                return str(candidate.resolve())
        except (OSError, ValueError):
            continue
    return None


def _scripts_dirs_in_root(root: str, bundle: str, skill: str) -> list[str]:
    """Return every ``{skill}/scripts`` directory one install root carries.

    Both deployed shapes are probed, newest first, and a root may name the
    bundle itself or sit above it (the flat targets' ``{root}/{bundle}-{skill}``
    and the nested targets' ``{root}/{bundle}/{version}/skills/{skill}``):

    1. **Nested, versioned** — ``{root}/{bundle}/{version}/skills/{skill}/scripts``
       and ``{root}/{version}/skills/{skill}/scripts``. Version dirs are ordered
       by numeric version tuple, newest first, so a stale dir left on disk can
       never shadow the current one.
    2. **Flat, unversioned** — ``{root}/{bundle}-{skill}/scripts``, plus the same
       join under a ``skills/`` or ``skill/`` child of the root.
    """
    if not root:
        return []
    dirs: list[str] = []
    try:
        base = Path(root).expanduser()
        for bundle_dir in (base / bundle, base):
            if not bundle_dir.is_dir():
                continue
            versioned: list[tuple[tuple[int, ...], str]] = []
            for version_dir in bundle_dir.iterdir():
                try:
                    if not version_dir.is_dir() or version_dir.name.startswith('.'):
                        continue
                    scripts_dir = version_dir / 'skills' / skill / 'scripts'
                    if scripts_dir.is_dir():
                        versioned.append((_version_key(version_dir.name), str(scripts_dir.resolve())))
                except (OSError, ValueError):
                    continue
            versioned.sort(reverse=True)
            dirs.extend(scripts for _key, scripts in versioned)
    except (OSError, ValueError, RuntimeError):
        pass
    flat_skill_dir = f'{bundle}-{skill}'
    for raw_root in (root,):
        try:
            base = Path(raw_root).expanduser()
            for skill_root in (base, base / 'skills', base / 'skill'):
                scripts_dir = skill_root / flat_skill_dir / 'scripts'
                if scripts_dir.is_dir():
                    dirs.append(str(scripts_dir.resolve()))
        except (OSError, ValueError, RuntimeError):
            continue
    return dirs


def _harness_search_order() -> list[tuple[str, str]]:
    """Return ``(harness, root)`` pairs in resolution order.

    The runtime harness's OWN roots first — the environment-declared one before
    the stamped one, because the layout op puts a config-dir override first —
    then every other harness in the declared order. A first-match-wins walk in
    this order means a call resolves to its own harness's code whenever that
    harness has a copy, and only reaches another harness's install as the last
    resort.

    The reader is part of the executor's own bootstrap surface, so the resolver
    body also runs in isolation (tests execute it standalone, with no environment
    layer): a missing reader means "no runtime signal", and a missing root list
    means "no stamped installs".
    """
    try:
        running = _runtime_harness()
    except NameError:
        running = None
    try:
        pairs = _all_known_roots()
    except NameError:
        # Standalone execution (tests run this body without the executor's own
        # module): fall back to whatever roots the namespace injected.
        try:
            pairs = list(_INSTALLED_ROOTS)
        except NameError:
            pairs = []
        try:
            pairs = pairs + [pair for pair in _env_harness_roots() if pair not in pairs]
        except NameError:
            pass
    try:
        declared = _env_harness_roots()
    except NameError:
        declared = []
    declared_own = [pair for pair in declared if pair[0] == running]
    own = [pair for pair in pairs if pair[0] == running and pair not in declared_own]
    rest = [pair for pair in pairs if pair[0] != running]
    return declared_own + own + rest


def _resolve_notation_by_target(notation: str) -> str | None:
    """Resolve ``notation`` against the tree, then every installed harness.

    ONE body for every harness. ``--target`` is a HINT for which install to
    prefer, never a fence: the resolution order is

    0. a live ``marketplace/bundles`` tree at or above this executor file;
    1. the runtime harness's own install root (its ``skills`` dirs, nested or
       flat, newest version first);
    2. every other installed harness root, in the declared order.

    Args:
        notation: Three-part notation ``{bundle}:{skill}:{script}``.

    Returns:
        Absolute path string, or ``None`` when no copy exists anywhere.
    """
    parts = notation.split(':')
    if len(parts) != 3:
        return None
    bundle, skill = parts[0], parts[1]
    relative = _relative_script_path(notation)
    if not relative:
        return None

    tree_hit = _tree_probe(notation)
    if tree_hit:
        return tree_hit

    for _harness, root in _harness_search_order():
        for scripts_dir in _scripts_dirs_in_root(root, bundle, skill):
            try:
                candidate = Path(scripts_dir) / relative
                if candidate.is_file():
                    return str(candidate.resolve())
            except (OSError, ValueError):
                continue
    return None
