def _is_build_class_notation(notation: str, subcommand: str) -> bool:
    """Return True when this dispatch actually executes a build.

    Build-class-ness is the CONJUNCTION of two conditions, BOTH required:

    1. ``notation`` starts with one of :data:`_BUILD_CLASS_PREFIXES` - the
       dispatch targets a script registered under a ``build-*`` skill.
    2. ``subcommand`` is a member of :data:`_BUILD_EXECUTING_SUBCOMMANDS` - the
       dispatched verb is the one that actually runs a build.

    The prefix alone is NOT sufficient. Every build wrapper also registers pure
    query verbs, and a bare ``--help`` dispatch carries no subcommand at all.
    Those exit 0 without building anything, so stamping them ``kind=build /
    status=success`` would let ``pre-commit-verify-freshness`` accept a query as
    proof that the current working tree was built.

    Args:
        notation: Script notation (``bundle:skill:script``).
        subcommand: The dispatched subcommand - the first argument after the
            notation, or the empty string when none was supplied. The empty
            string is never build-executing.

    Returns:
        True only when BOTH the notation prefix matches AND the subcommand is
        build-executing.
    """
    if subcommand not in _BUILD_EXECUTING_SUBCOMMANDS:
        return False
    return any(notation.startswith(prefix) for prefix in _BUILD_CLASS_PREFIXES)


def _parse_build_payload(stdout: str) -> dict | None:
    """Parse the dispatched build wrapper's stdout TOON exactly ONCE.

    The payload is the source of FOUR ledger facts — the truthful ``status``,
    the resolved ``command``, the measured ``duration_seconds``, and the whole
    ``outcome`` dict. Parsing it here once and threading the result to each
    consumer keeps the boundary from re-parsing the same string per field.

    Defensive by construction: empty, non-TOON, or non-mapping stdout yields
    ``None`` and never raises, so every consumer takes its own payload-less
    branch (status falls back to the exit code, the other three stay ``None``).

    Args:
        stdout: The captured stdout of the dispatched build wrapper.

    Returns:
        The parsed payload as a dict, or ``None`` when it cannot be parsed.
    """
    if not stdout:
        return None
    try:
        parsed = parse_toon(stdout.strip())
    except Exception:
        return None
    return parsed if isinstance(parsed, dict) else None


def _payload_str(payload: dict | None, key: str) -> str | None:
    """Return ``payload[key]`` when it is a non-empty string, else ``None``.

    The payload is externally-sourced parsed text, so a field can legitimately
    be absent, null, or a non-string (a nested block). Anything that is not a
    usable string is reported as absent rather than coerced.
    """
    if payload is None:
        return None
    value = payload.get(key)
    return value if isinstance(value, str) and value else None


def _payload_number(payload: dict | None, key: str) -> float | None:
    """Return ``payload[key]`` as a float when it is numeric, else ``None``.

    ``parse_toon`` already coerces a bare TOON numeric to ``int`` / ``float``,
    so no string parsing is needed here — the guard only rejects a missing,
    null, or non-numeric field. ``bool`` is excluded explicitly because it is a
    Python ``int`` subclass and would otherwise coerce to ``0.0`` / ``1.0``.
    """
    if payload is None:
        return None
    value = payload.get(key)
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def _derive_build_status(exit_code: int, payload: dict | None) -> str:
    """Derive the truthful build outcome for the ``kind=build`` ledger stamp.

    Derivation order — a nonzero exit code is AUTHORITATIVE over any stdout
    status, so a script that prints ``status: success`` while exiting non-zero
    can never launder a real process failure into a fresh-looking build:

    1. ``exit_code < 0`` → ``killed``. ``subprocess.run`` reports a child
       terminated by a POSIX signal as a negative returncode, so a build
       killed while the executor survives is stamped truthfully. ``killed``
       is reserved for this branch — a stdout status never produces it.
    2. Any other nonzero ``exit_code`` → ``error``, regardless of what the
       stdout TOON claims (a contradictory ``status: success`` /
       nonzero-exit combination stamps ``error``).
    3. ``exit_code == 0`` AND the parsed stdout payload carries a ``status``
       the WRAPPER is entitled to claim (see
       ``_ledger_core.WRAPPER_CLAIMABLE_BUILD_STATUSES``) → that status. This
       closes the false-fresh hole: the build wrapper reports
       ``status: timeout`` on stdout while the PROCESS exits 0, so the stdout
       TOON — not the exit code — carries the real outcome. A stdout claim of
       ``killed`` at exit 0 stamps ``error``: ``killed`` is derived-only, so
       the claim is untrustworthy — but it must not launder into ``success``
       either.
    4. Else (``exit_code == 0`` with no claimable status on the payload —
       absent, unparseable, null, or a value outside the wrapper's
       vocabulary) → ``unknown``. **Never ``success``.** Exit 0 alone proves
       the process ended, not that a build ran and passed; the wrapper models
       its verdict in the payload, so a payload this function cannot read
       leaves the outcome UNDETERMINED. Stamping ``success`` there would mint
       the exact false-fresh ``kind=build`` row
       ``pre-commit-verify-freshness`` accepts as proof the tree was built.
       ``unknown`` is derived-only and is NOT ``success``, so the gate fails
       closed on it.

    Defensive by construction: a malformed / absent stdout TOON reaches this
    function as ``payload=None`` (see :func:`_parse_build_payload`) and is
    handled at every exit code — it falls through to the ``unknown`` branch at
    exit 0, and to ``killed`` / ``error`` per rule 2 on a nonzero exit, so an
    unreadable payload never resolves to ``success`` on any path. A payload
    whose ``status`` is not a string is likewise ignored rather than compared,
    so no shape of parsed stdout can raise here.

    Args:
        exit_code: The subprocess returncode observed at the boundary.
        payload: The wrapper's stdout TOON as parsed ONCE by
            :func:`_parse_build_payload`, or ``None`` when it was absent or
            unparseable.

    Returns:
        One of ``success`` / ``error`` / ``timeout`` / ``killed`` /
        ``unknown``.
    """
    if exit_code < 0:
        return 'killed'
    if exit_code != 0:
        return 'error'
    candidate = _payload_str(payload, 'status')
    if candidate is not None:
        if candidate == 'killed':
            return 'error'
        if candidate in WRAPPER_CLAIMABLE_BUILD_STATUSES:
            return candidate
    return 'unknown'


def _append_build_ledger_record(
    notation: str,
    plan_id: str,
    script_args: list[str],
    exit_code: int,
    stdout: str,
    log_file: str | None,
) -> None:
    """Append one ``kind=build`` change-ledger entry for a build-class dispatch.

    Fired from :func:`main` after the subprocess completes (regardless of
    outcome — the freshness gate filters on the stamped ``status``). Parses the
    wrapper's stdout TOON ONCE via :func:`_parse_build_payload` and threads the
    result through every consumer: it derives the truthful build ``status`` via
    :func:`_derive_build_status` (returncode signal-death check, then
    nonzero-exit → ``error``, then the payload's ``status`` on a zero exit),
    and reads the resolved ``command``, the measured ``duration_seconds`` and
    the whole payload as ``outcome`` from that same parse. It then
    computes the working-tree currency hash via the shared
    :func:`compute_worktree_sha` against the executor's cwd (pinned to the
    worktree in phase-5, the main checkout otherwise), builds the record via
    :func:`build_record` (which stamps ``kind: "build"`` and the ISO
    timestamp), and appends it via the pure-append :func:`append_entry`
    (which resolves the ledger path under the tracked-config ``work/`` dir).

    ``args`` and ``command`` are recorded as two DISTINCT layers: ``args`` is
    the executor argv this function was handed, ``command`` is what the wrapper
    resolved that argv into and actually ran. See
    :func:`_ledger_core.build_record` for the contract.

    Fire-and-forget: the whole body — INCLUDING the parse and the status
    derivation — is wrapped in a broad ``try/except`` that returns silently. An
    unparseable payload does not even reach the guard: it yields ``None`` and
    the row is still written, with ``command`` / ``duration_seconds`` /
    ``outcome`` absent. A derivation or ledger-write failure never alters the
    dispatched script's exit code, stdout, or stderr.

    Args:
        notation: The build-class notation that was dispatched.
        plan_id: Resolved plan id — never ``None``. A build dispatched outside
            any plan (an orchestrator global-tier build, an ad-hoc CLI run)
            carries the ``NO_PLAN`` sentinel, so every ledger row is
            attributable.
        script_args: Arguments forwarded to the dispatched script. Joined into
            the free-form ``args`` field — the EXECUTOR argv layer.
        exit_code: The build exit code (recorded even when non-zero).
        stdout: The captured stdout of the dispatched wrapper — the single
            source of the ``status`` derivation plus the recorded ``command``,
            ``duration_seconds`` and ``outcome``.
        log_file: The script-execution log path for this dispatch.
    """
    try:
        payload = _parse_build_payload(stdout)
        status = _derive_build_status(exit_code, payload)
        worktree_sha = compute_worktree_sha(os.getcwd())
        record = build_record(
            notation=notation,
            plan_id=plan_id,
            args=' '.join(script_args) if script_args else None,
            command=_payload_str(payload, 'command'),
            duration_seconds=_payload_number(payload, 'duration_seconds'),
            outcome=payload,
            exit_code=exit_code,
            status=status,
            worktree_sha=worktree_sha,
            log_file=log_file,
        )
        append_entry(record)
    except Exception:
        # Fire-and-forget — never propagate failures from the ledger boundary.
        return


def _classify_dispatch_failure(exit_code: int) -> str:
    """
    Classify a non-zero dispatch exit code into a failure kind.

    Python's argparse exits with code 2 on parse failure (unrecognized args,
    missing required args, type-coercion failures, etc.). Distinguishing this
    from a script-internal failure (uncaught exception, explicit sys.exit(1),
    business-logic failure) gives consumers of work.log a structural signal
    they can grep for without parsing stderr.

    Args:
        exit_code: Non-zero process exit code.

    Returns:
        ``argparse_rejection`` when exit_code == 2, ``script_internal_failure``
        for any other non-zero value.
    """
    if exit_code == 2:
        return 'argparse_rejection'
    return 'script_internal_failure'


def _derive_failure_detail(stdout: str, stderr: str) -> str:
    """
    Derive the single-line diagnostic detail for a failed dispatch.

    plan-marshall scripts report structured errors on **stdout** as a
    ``status: error`` TOON payload while exiting non-zero with empty stderr, so
    surfacing only stderr leaves the work.log entry blank and undiagnosable.
    This helper implements option-A precedence — always prefer the reason the
    script itself reported on stdout, falling back to stderr only as a last
    resort:

    1. ``stdout`` parses as a ``status: error`` TOON payload carrying a
       non-empty ``message`` field → return that ``message``.
    2. else ``stdout`` is non-empty → return the raw ``stdout``.
    3. else ``stderr`` is non-empty → return the raw ``stderr`` (last resort,
       covers genuine stderr-only crashes).

    The chosen text is truncated to :data:`_DISPATCH_FAILURE_DETAIL_LIMIT`
    characters and has its newlines collapsed so the work.log entry stays
    single-line.

    Args:
        stdout: Captured stdout from the failed dispatch.
        stderr: Captured stderr from the failed dispatch.

    Returns:
        The single-line, truncated diagnostic detail. Empty string only when
        both stdout and stderr are empty.
    """
    stdout_clean = (stdout or '').strip()
    stderr_clean = (stderr or '').strip()

    detail = ''
    if stdout_clean:
        # Precedence (1): try to parse stdout as a status: error TOON payload
        # and surface its message field. Guarded so non-TOON stdout falls
        # through to precedence (2).
        try:
            parsed = parse_toon(stdout_clean)
            if (
                parsed.get('status') == 'error'
                and parsed.get('message')
            ):
                detail = str(parsed['message']).strip()
        except Exception:
            detail = ''
        # Precedence (2): non-empty unstructured stdout.
        if not detail:
            detail = stdout_clean
    elif stderr_clean:
        # Precedence (3): stderr last resort.
        detail = stderr_clean

    if len(detail) > _DISPATCH_FAILURE_DETAIL_LIMIT:
        detail = detail[:_DISPATCH_FAILURE_DETAIL_LIMIT] + '...[truncated]'
    # Collapse newlines so the work.log entry stays single-line.
    detail = detail.replace('\n', ' \\n ').replace('\r', '')

    return detail


def emit_dispatch_failure_work_log(
    notation: str,
    exit_code: int,
    stdout: str,
    stderr: str,
    script_args: list[str],
    audit_plan_id: str | None,
) -> None:
    """
    Emit a [ERROR] entry to the plan's work.log when a dispatched script
    exits non-zero.

    Three guard rails keep the boundary cheap and recursion-free:

    1. Successful dispatches (exit_code == 0) are skipped at the call site —
       this function assumes the caller already filtered them out.
    2. ``manage-logging`` dispatches are skipped via
       ``_DISPATCH_FAILURE_SUPPRESS_NOTATIONS``. A failure inside
       manage-logging that tried to log itself would re-invoke the executor
       and recurse forever.
    3. work.log is plan-scoped: we need a ``--plan-id`` to know which plan's
       work.log to append to. When neither the dispatched script's own
       arguments nor the executor's ``--audit-plan-id`` flag carry a plan id,
       the entry is dropped silently (the script-execution.log entry from
       :func:`log_script_execution` still records the failure globally).

    The emission itself is wrapped in a broad ``try/except`` so logging
    failures never crash the executor — the dispatched script's exit code is
    the user-visible contract, work.log is best-effort observability.

    The emitted ``detail=`` field carries the reason the script itself
    reported, derived via :func:`_derive_failure_detail` with option-A
    precedence: a ``status: error`` TOON ``message`` on stdout, else non-empty
    raw stdout, else stderr as a last resort. This ensures a non-zero exit that
    reports its error on stdout (the common plan-marshall case) is never again
    surfaced as a blank diagnostic.

    Args:
        notation: Failing script notation (``bundle:skill:script``).
        exit_code: Non-zero exit code observed at the subprocess boundary.
        stdout: Captured stdout from the failed dispatch. Preferred source of
            the ``detail`` field (see :func:`_derive_failure_detail`).
        stderr: Captured stderr from the failed dispatch. Last-resort source of
            the ``detail`` field. The chosen text is truncated to
            :data:`_DISPATCH_FAILURE_DETAIL_LIMIT` characters before emission.
        script_args: Arguments forwarded to the dispatched script (after
            ``--audit-plan-id`` extraction). Searched for ``--plan-id``.
        audit_plan_id: Value of the executor's own ``--audit-plan-id`` flag
            (or ``None`` when absent). Used as fallback when ``script_args``
            does not carry a ``--plan-id``.
    """
    if notation in _DISPATCH_FAILURE_SUPPRESS_NOTATIONS:
        return

    try:
        # Deliberately NOT `_ledger_plan_id`: this plan_id selects a plan
        # DIRECTORY to write into, so it stays the value the caller actually
        # supplied and gets no NO_PLAN fallback. A caller that passes
        # `--plan-id NO_PLAN` explicitly still lands in the sentinel's work log
        # (the same shared plan-less store every other NO_PLAN consumer uses);
        # a dispatch that named no plan at all writes nothing, unchanged.
        plan_id = extract_plan_id(script_args) or audit_plan_id
        if not plan_id:
            return

        failure_kind = _classify_dispatch_failure(exit_code)
        detail = _derive_failure_detail(stdout, stderr)

        message = (
            f'[ERROR] (plan-marshall:execute-script:{exit_code}) script_failure '
            f'notation={notation} exit_code={exit_code} failure_kind={failure_kind} '
            f'detail={detail}'
        )
        log_entry('work', plan_id, 'ERROR', message)
    except Exception:
        # Logging is best-effort — never propagate failures from the boundary.
        pass


# ============================================================================
# PRE-SPAWN INVOCATION VALIDATION
# ============================================================================
# Refuses a dispatch whose verb path or flags the target script cannot accept,
# BEFORE any subprocess starts. Without it, an invented subcommand surfaces only
# as a raw argparse ``exit_code: 2`` with usage text on stderr and NOTHING on
# stdout — a shape a caller that parses stdout reads as empty rather than as a
# correction.
#
# FAIL-OPEN BY CONSTRUCTION. Every branch that lacks confident knowledge spawns
# exactly as it did before this check existed:
#
#   - the notation has no SCRIPT_SURFACES entry          -> spawn
#   - a node's child listing is not confident            -> stop walking, spawn
#   - the resolved node's flag set is not known          -> skip flag checks
#   - a flag's value arity is unknown WHILE a verb is
#     still expected (so the next token is either that
#     flag's value or the verb, and no reading of argv
#     resolves the parser node)                          -> spawn
#
# The asymmetry is the whole safety argument: rejecting is only ever done from
# POSITIVE knowledge that a token is not accepted. Absent knowledge is never
# converted into a rejection, so the worst case of a derivation gap is today's
# behaviour, never a valid call refused.


# Long flags accepted on EVERY node regardless of what the derived surface says,
# mapped to the number of argv tokens each binds as its value. Each is invisible
# to the derivation for a structural reason, so validating against the surface
# alone rejects calls that are unambiguously valid:
#
#   - ``help``           — every argparse parser declares it, and the derivation
#                          strips it deliberately (it carries no information
#                          about the script's own surface). Rejecting ``--help``
#                          would break the very probe the derivation itself uses.
#   - ``audit-plan-id``  — consumed by THIS executor before the target script's
#                          argparse ever runs, so it appears in no node's help.
#   - ``plan-id`` /
#     ``project-dir``    — declared on many ROOT parsers and honoured on every
#                          subcommand by argparse's parent-flag propagation, but
#                          rendered only in the root's help. The ancestor union
#                          already covers the root-declared case; the allowlist
#                          is the guarantee for the executor-injected one.
#
# The arity values are a LAST-RESORT fallback, consulted only for a flag the
# derived surface has no arity for: the same structural invisibility that puts a
# flag on this list is what can keep it out of every node's rendered help, and
# these four have a fixed, known shape. A derived arity always wins, so a script
# that declares one of these names differently is described by its own help.
#
# A LITERAL MIRROR of ``UNIVERSAL_FLAG_ARITY`` in
# ``plan-marshall:script-shared``'s ``argparse_surface`` module — the single
# definition of this accept-set, which plugin-doctor's manage-invocation rule
# imports directly. This executor cannot import it: it is a self-contained
# generated artifact that must dispatch before any shared module is on the path,
# and the surfaces it validates against were derived by the very module it would
# be importing. So the copy is unavoidable, and it is NOT trusted to stay in step
# by convention — ``test_template_accept_set_mirrors_the_shared_definition``
# parses this literal out of the template and fails the moment the two diverge.
# The reason a divergence matters is behavioural, not cosmetic: a flag accepted
# here but absent there is reported as an unregistered-flag documentation defect
# at edit time against a call that dispatches perfectly well.
_ALWAYS_ACCEPTED_FLAG_ARITY = {
    'help': 0,
    'audit-plan-id': 1,
    'plan-id': 1,
    'project-dir': 1,
}
_ALWAYS_ACCEPTED_FLAGS = frozenset(_ALWAYS_ACCEPTED_FLAG_ARITY)


def _surface_for(notation: str) -> dict | None:
    """Return the embedded root node for ``notation``, or ``None`` when absent."""
    entry = SCRIPT_SURFACES.get(notation)
    if not isinstance(entry, dict):
        return None
    surface = entry.get('surface')
    if not isinstance(surface, dict):
        return None
    root = surface.get('root')
    return root if isinstance(root, dict) else None


def _mentions_help(script_args: list) -> bool:
    """True when argv carries argparse's help flag in ANY spelling it fires on.

    The question this answers is not "did the caller type ``--help``" but "will
    argparse print usage instead of running the verb". Every parser argparse
    builds declares the help action under BOTH ``-h`` and ``--help``, and fires
    it at whatever depth the token appears, so anchoring on one spelling refuses
    calls the other spelling makes valid — ``manage-tasks read -h`` was rejected
    for its missing required flags while ``manage-tasks read --help`` printed
    usage.

    Four token shapes match:

    - ``--help`` — the long form;
    - ``--help=...`` — the long form with an inline value argparse ignores;
    - ``-h`` — the short form;
    - ``-vh`` / ``-hv`` — the short form inside a cluster, which argparse splits
      into its constituent single-character options.

    A cluster is matched on CONTAINING ``h`` at all, which is deliberately wider
    than argparse's own reading: in ``-fh``, argparse binds ``h`` as ``-f``'s
    value rather than firing help, and this returns True anyway. That is the
    safe direction and the only one available without modelling every script's
    short-flag surface (the derivation models long flags only). A false True
    short-circuits to spawn — precisely what this executor did before any
    validation existed, and what every other fail-open branch does. A false
    False refuses a call argparse would have answered, which is the one outcome
    the design rules out.

    Long flags that merely BEGIN with the word are not help: ``--helpful`` and
    ``--help-me`` are ordinary flags and stay fully validated, which is why the
    long form is matched exactly rather than by prefix.
    """
    for arg in script_args:
        if arg == '--help' or arg.startswith('--help='):
            return True
        if arg.startswith('--') or not arg.startswith('-'):
            # A long flag that is not ``--help``, a bare ``-``/``--``, or a
            # positional. None of them can carry the short form.
            continue
        if 'h' in arg[1:]:
            return True
    return False


def _closest_spelling(token: str, candidates) -> str | None:
    """Return the accepted spelling closest to ``token``, or ``None``.

    A cheap edit-distance pick so the corrective can say "did you mean X?"
    rather than dumping the whole accepted set. Returns ``None`` when nothing is
    within a plausible typo distance, because a wrong guess is worse than no
    guess — it sends the caller to a verb they did not want.
    """
    def _distance(a: str, b: str) -> int:
        previous = list(range(len(b) + 1))
        for i, ch_a in enumerate(a, 1):
            current = [i]
            for j, ch_b in enumerate(b, 1):
                current.append(min(
                    previous[j] + 1,
                    current[j - 1] + 1,
                    previous[j - 1] + (ch_a != ch_b),
                ))
            previous = current
        return previous[-1]

    best = None
    best_distance = None
    for candidate in sorted(candidates):
        distance = _distance(token, candidate)
        if best_distance is None or distance < best_distance:
            best, best_distance = candidate, distance
    if best is None or best_distance is None:
        return None
    # Accept a suggestion only when it is closer than "rewrite the whole token".
    return best if best_distance <= max(2, len(token) // 2) else None


def _corrective_for_verb(notation: str, chain: list, token: str, node: dict) -> str:
    """Phrase the corrective for an unaccepted verb token.

    When the closest accepted spelling is itself an ALIAS, the message says so —
    the grouping anchor recovered that relation, and "``get`` is an alias of
    ``read``" is a more useful correction than a bare nearest-match.
    """
    children = sorted(node.get('children') or {})
    prefix = ' '.join([notation, *chain]).strip()
    suggestion = _closest_spelling(token, children)
    if suggestion is None:
        return f'Use a registered verb for `{prefix}`: {children}'
    alias_of = node.get('alias_of') or {}
    canonical = alias_of.get(suggestion)
    if canonical:
        return (
            f'Use `{prefix} {suggestion}` (an alias of `{canonical}`) — '
            f'registered: {children}'
        )
    return f'Use `{prefix} {suggestion}` — registered: {children}'


def _consume_flag_value(name, arity: dict, node: dict, script_args: list, index: int):
    """How many argv tokens the flag preceding ``index`` binds as its value.

    ``None`` means the answer is BOTH unknown and load-bearing, and is the
    signal for the caller to abandon validation and spawn.

    Three cases, in order:

    1. Nothing follows, or the next token is itself ``-``-prefixed. argparse
       binds no value here whatever the declared arity is, so the answer is a
       confident ``0`` and no arity lookup is needed.
    2. The arity is known. Consume that many tokens, stopping early at a
       ``-``-prefixed token or at the end of argv.
    3. The arity is unknown. The next token is either this flag's value or the
       next verb, and the two readings resolve DIFFERENT parser nodes — so the
       answer only matters while the current node still expects a verb. When it
       does, return ``None`` (spawn); when it does not, the token is not a verb
       under any reading, so consuming it is safe and loses nothing.

    ``name`` is ``None`` for a short flag or cluster: the derivation models long
    flags only, so case 2 can never apply to one. Lookup is by EXACT name — the
    marketplace-wide ``argparse_safety`` rule requires every parser and
    subparser to pass ``allow_abbrev=False``, so no abbreviated spelling ever
    binds a value and resolving one here would model a behaviour the scripts
    deliberately do not have.
    """
    if index >= len(script_args) or script_args[index].startswith('-'):
        return 0
    declared = arity.get(name) if name else None
    if declared is None:
        return None if node.get('children') else 1
    consumed = 0
    while consumed < declared and index + consumed < len(script_args):
        if script_args[index + consumed].startswith('-'):
            break
        consumed += 1
    return consumed


def _resolve_invocation(notation: str, root: dict, script_args: list) -> tuple:
    """Walk argv against the surface tree, consuming flag values by derived arity.

    A single left-to-right pass does BOTH jobs, because neither can be done
    without the other: tokenizing argv needs the current node's arity map (which
    flags bind a following token), and reaching the current node needs argv
    already tokenized. Splitting them is what let a leading ``--project-dir .``
    swallow the verb that followed it, leaving the walk parked on the ROOT node
    and every subcommand-declared flag looking unknown.

    Returns ``(resolution, rejection)`` — at most one is ever non-``None``, and
    both are ``None`` when the walk cannot judge:

    - ``(None, None)``       — no confident reading of argv; the caller spawns.
    - ``(None, rejection)``  — a positional named an unregistered child.
    - ``(resolution, None)`` — argv resolved; the mapping carries the verb
      ``chain``, the deepest ``node``, the long ``flags`` used, the ancestor-
      union ``inherited`` accept-set, and whether that set is ``flags_known``.
    """
    node = root
    chain = []
    flags = []
    inherited = set(root.get('flags') or []) | _ALWAYS_ACCEPTED_FLAGS
    arity = dict(_ALWAYS_ACCEPTED_FLAG_ARITY)
    arity.update(root.get('flag_arity') or {})
    flags_known = bool(root.get('flags_confident', True))

    index = 0
    total = len(script_args)
    while index < total:
        token = script_args[index]
        index += 1

        if token == '--':
            # argparse's end-of-options marker: every later token is a
            # positional VALUE. A node still expecting a verb can no longer get
            # one from argv, so there is nothing left to resolve against.
            if node.get('children'):
                return None, None
            break

        if token.startswith('--'):
            name = token[2:].split('=', 1)[0]
            if not name:
                return None, None
            flags.append(name)
            if '=' in token[2:]:
                # ``--flag=value`` carries its value inline and binds no
                # following token, so its arity is irrelevant here.
                continue
            consumed = _consume_flag_value(name, arity, node, script_args, index)
            if consumed is None:
                return None, None
            index += consumed
            continue

        if token.startswith('-'):
            # A short flag or cluster. Its own acceptance is never asserted (the
            # derived surface models long flags only), but its VALUE still has
            # to be stepped over so it is not walked as a verb.
            consumed = _consume_flag_value(None, arity, node, script_args, index)
            if consumed is None:
                return None, None
            index += consumed
            continue

        children = node.get('children') or {}
        if not children:
            # A leaf's positional ARGUMENT, not a verb. Nothing to validate.
            continue
        if not node.get('children_confident', True):
            return None, None
        child = children.get(token)
        if child is None:
            return None, {
                'reason': 'unknown_verb',
                'token': token,
                'corrective': _corrective_for_verb(notation, chain, token, node),
                'accepted': sorted(children),
            }
        chain.append(token)
        node = child
        inherited |= set(node.get('flags') or [])
        arity.update(node.get('flag_arity') or {})
        flags_known = flags_known and bool(node.get('flags_confident', True))

    resolution = {
        'chain': chain,
        'node': node,
        'flags': flags,
        'inherited': inherited,
        'flags_known': flags_known,
    }
    return resolution, None


def _validate_invocation(notation: str, script_args: list) -> dict | None:
    """Return a rejection dict when the dispatch is provably invalid, else ``None``.

    ``None`` means "spawn" and covers BOTH "this call is valid" and "I do not
    know enough to judge" — the two are deliberately indistinguishable to the
    caller, because both must dispatch.
    """
    root = _surface_for(notation)
    if root is None:
        return None

    # A help flag in EITHER spelling (``--help`` or ``-h``) short-circuits the
    # whole check. argparse handles it at whatever depth it appears and prints
    # usage instead of running the verb, so a partial or misspelled verb path
    # alongside it is not an error to report, and a leaf's required flags are
    # not missing from a call that will never reach the leaf — and refusing it
    # would break the derivation's own probe.
    if _mentions_help(script_args):
        return None

    resolution, rejection = _resolve_invocation(notation, root, script_args)
    if rejection is not None:
        return rejection
    if resolution is None or not resolution['flags_known']:
        return None

    node = resolution['node']
    chain = resolution['chain']
    inherited_flags = resolution['inherited']
    flags = resolution['flags']

    for flag in flags:
        if flag in inherited_flags:
            continue
        prefix = ' '.join([notation, *chain]).strip()
        # Report the script's OWN declared flags. The universally-accepted ones
        # are structural (see _ALWAYS_ACCEPTED_FLAGS) and listing them as
        # "declared here" would misdescribe the script's surface.
        declared = sorted(inherited_flags - _ALWAYS_ACCEPTED_FLAGS)
        suggestion = _closest_spelling(flag, declared)
        if suggestion:
            corrective = f'Use `--{suggestion}` for `{prefix}` — declared: {declared}'
        else:
            corrective = f'Use a declared flag for `{prefix}`: {declared}'
        return {
            'reason': 'unknown_flag',
            'token': f'--{flag}',
            'corrective': corrective,
            'accepted': declared,
        }

    missing = sorted(set(node.get('required_flags') or []) - set(flags))
    if missing:
        prefix = ' '.join([notation, *chain]).strip()
        return {
            'reason': 'missing_required_flag',
            'token': ', '.join(f'--{name}' for name in missing),
            'corrective': f'Add the required flag(s) to `{prefix}`: {missing}',
            'accepted': sorted(node.get('required_flags') or []),
        }

    return None


def _render_rejection_toon(notation: str, rejection: dict) -> str:
    """Render the refusal as a ``status: error`` TOON payload for STDOUT.

    STDOUT, not stderr, and structured rather than argparse's usage text: the
    whole point of rejecting here is that a caller which parses stdout receives
    a CORRECTION where it previously received nothing at all.
    """
    accepted = ', '.join(str(item) for item in rejection.get('accepted') or [])
    return '\n'.join([
        'status: error',
        'error: invalid_invocation',
        f'notation: {notation}',
        f'reason: {rejection["reason"]}',
        f'rejected: {rejection["token"]}',
        f'accepted: {accepted}',
        f'message: {rejection["corrective"]}',
    ])


def _args_for_logging(script_args: list, audit_plan_id: str | None) -> list:
    """Args as the script log should record them, with `--plan-id` re-injected.

    `--audit-plan-id` is stripped before dispatch, so a log entry built from the
    raw `script_args` would carry no plan id at all and `log_script_execution`
    would route it to the global log instead of the plan's. Re-injecting the
    resolved id restores the routing. Shared by the pre-spawn rejection path and
    the post-dispatch path so the two record identically.
    """
    if audit_plan_id:
        return ['--plan-id', audit_plan_id] + list(script_args)
    return list(script_args)


def should_skip_logging(notation: str, exit_code: int) -> bool:
    """
    Determine if logging should be skipped for this execution.

    Logging scripts (like manage-logging) are not logged when successful to avoid
    meta-logging noise. Errors are always logged regardless of script type.

    Args:
        notation: Script notation (e.g., 'plan-marshall:manage-logging:manage-logging')
        exit_code: Script exit code (0 = success)

    Returns:
        True if logging should be skipped, False otherwise
    """
    return notation in SILENT_ON_SUCCESS and exit_code == 0


def extract_audit_plan_id(args: list[str]) -> tuple[str | None, list[str]]:
    """
    Extract --audit-plan-id from args and return cleaned args.

    --audit-plan-id is audit-only: it routes the executor's own log entry to the
    plan-specific log file and is stripped before passing args to the script.
    The flag never alters the script's behavior — use it for scripts that do not
    accept --plan-id themselves.

    Args:
        args: Command line arguments

    Returns:
        Tuple of (audit_plan_id or None, cleaned_args without --audit-plan-id)
    """
    audit_plan_id = None
    cleaned = []
    skip_next = False

    for i, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if arg == '--audit-plan-id':
            if i + 1 < len(args):
                audit_plan_id = args[i + 1]
                skip_next = True
        elif arg.startswith('--audit-plan-id='):
            audit_plan_id = arg.split('=', 1)[1]
        else:
            cleaned.append(arg)

    return audit_plan_id, cleaned


def _resolve_notation_by_cwd_walk(notation: str) -> str | None:
    """Resolve notation by walking up to a ``marketplace/bundles`` tree.

    Self-heal path for the dev-checkout case: when the embedded SCRIPTS path
    is stale/relocated and the target-aware (plugin-cache / OpenCode) resolver
    finds nothing, walk upward from two anchors looking for a live
    ``marketplace/bundles/{bundle}/skills/{skill}/scripts/{script}.py``:

    1. Each ancestor of ``Path.cwd()`` (covers an executor invoked from inside
       a checkout / worktree where cwd sits under the repo root).
    2. Each ancestor of this executor file's own location (covers an executor
       whose cwd is elsewhere but which itself lives under the checkout).

    The first existing match is returned as an absolute path; ``None`` when no
    anchor yields a live file. No glob, no env var — a pure upward directory
    walk so a relocated checkout resolves without a regeneration or a
    hand-pinned ``PM_MARKETPLACE_ROOT``.
    """
    parts = notation.split(':')
    if len(parts) != 3:
        return None
    bundle, skill, script = parts
    rel = Path('marketplace') / 'bundles' / bundle / 'skills' / skill / 'scripts' / f'{script}.py'

    anchors: list[Path] = []
    try:
        anchors.append(Path.cwd())
    except (OSError, ValueError):
        pass
    try:
        anchors.append(Path(__file__).resolve())
    except (OSError, ValueError, NameError):
        pass

    seen: set[str] = set()
    for anchor in anchors:
        for parent in [anchor, *anchor.parents]:
            key = str(parent)
            if key in seen:
                continue
            seen.add(key)
            try:
                candidate = parent / rel
                if candidate.is_file():
                    return str(candidate.resolve())
            except (OSError, ValueError):
                continue
    return None


def resolve_notation(notation: str) -> str | None:
    """Resolve notation to absolute script path.

    Resolution order:
    1. Direct lookup in SCRIPTS (embedded at generation time) — returned ONLY
       when the embedded path still exists on disk. A stale/relocated embedded
       path is skipped so resolution self-heals via the dynamic fallbacks
       instead of returning a dead path (which previously forced operators to
       hand-pin PM_MARKETPLACE_ROOT on every call).
    2. Prefix/substring fallback in SCRIPTS (compatibility shim) — same
       existence guard applies.
    3. Target-aware dynamic resolver (_resolve_notation_by_target) —
       returns an absolute path discovered from the target-specific skill
       discovery roots (Claude plugin cache or OpenCode config roots).
    4. cwd/executor-file upward walk to a live ``marketplace/bundles`` tree
       (_resolve_notation_by_cwd_walk) — covers the dev-checkout case where the
       target-aware roots are absent.
    """
    # 1. Direct lookup — only honour the embedded path when it still exists.
    if notation in SCRIPTS:
        direct = SCRIPTS[notation]
        if Path(direct).is_file():
            return direct

    # 2. Prefix/substring compatibility shim — same existence guard.
    for key, path in SCRIPTS.items():
        if key.startswith(notation) or notation in key:
            if Path(path).is_file():
                return path

    # 3. Target-aware dynamic fallback (plugin-cache / OpenCode roots).
    resolved = _resolve_notation_by_target(notation)
    if resolved:
        return resolved

    # 4. cwd / executor-file upward walk to a live marketplace/bundles tree.
    return _resolve_notation_by_cwd_walk(notation)


def build_notation_error(notation: str) -> tuple[str, list[str]]:
    """
    Build helpful error message for invalid notation.

    Returns:
        Tuple of (error_message, suggestions)
    """
    suggestions = [key for key in sorted(SCRIPTS.keys()) if notation.lower() in key.lower()]

    # Check if this looks like a subcommand was used as script name
    parts = notation.split(':')
    if len(parts) == 3:
        prefix = f"{parts[0]}:{parts[1]}"
        possible_cmd = parts[2]
        matching_scripts = [k for k in SCRIPTS.keys() if k.startswith(prefix + ':')]
        if matching_scripts:
            correct_script = matching_scripts[0].split(':')[2]
            error_msg = (
                f"Invalid notation: '{notation}'\n"
                f"  The third part '{possible_cmd}' appears to be a subcommand, not a script name.\n"
                f"  Correct format: {prefix}:{correct_script} {possible_cmd}"
            )
            return error_msg, suggestions

    return f"Unknown notation: {notation}", suggestions


def handle_invalid_notation(notation: str, remaining_args: list[str]) -> None:
    """Handle invalid notation lookup with logging and helpful error output."""
    error_msg, suggestions = build_notation_error(notation)

    # Log the invalid lookup
    log_script_execution(
        notation=notation,
        subcommand='',
        args=remaining_args,
        exit_code=1,
        duration=0.0,
        stdout='',
        stderr=error_msg
    )

    print(f"SCRIPT_ERROR\t{notation}\t1\tUnknown notation", file=sys.stderr)
    print(f"\n{error_msg}", file=sys.stderr)
    if suggestions:
        print(f"\nAvailable scripts matching '{notation}':", file=sys.stderr)
        for key in suggestions:
            print(f"  {key}", file=sys.stderr)
    sys.exit(1)


def main():
    if len(sys.argv) < 2:
        print("Usage: execute-script.py <notation> [subcommand] [args...]", file=sys.stderr)
        print("\nNotation format: {bundle}:{skill}:{script}", file=sys.stderr)
        print("\nAvailable scripts:", file=sys.stderr)
        for notation in sorted(SCRIPTS.keys()):
            print(f"  {notation}", file=sys.stderr)
        sys.exit(1)

    notation = sys.argv[1]

    # Handle --list option
    if notation == '--list':
        for n in sorted(SCRIPTS.keys()):
            print(n)
        sys.exit(0)

    remaining_args = sys.argv[2:]

    # Extract --audit-plan-id (audit logging only, stripped before passing to script)
    audit_plan_id, script_args = extract_audit_plan_id(remaining_args)

    # Strip empty string args (defensive: agents may pass empty args from shell variable expansion)
    script_args = [a for a in script_args if a]

    # Subcommand is first arg after stripping audit-plan-id
    subcommand = script_args[0] if script_args else ''

    # Resolve the plan_id for the build-class change-ledger boundary below
    # (script-arg --plan-id or executor --audit-plan-id; None when the dispatch
    # named no plan at all). The executor no longer writes any session->plan
    # binding — that policy now lives in platform-runtime's `session bind`,
    # fired from the manage-status phase-state-write drive seam.
    #
    # TWO values, deliberately not one. `_active_plan_id` stays the value the
    # CALLER supplied and is what selects a plan DIRECTORY (the script-log
    # path below); `_ledger_plan_id` is the ROUTING/LEDGER value and falls back
    # to the NO_PLAN sentinel so no kind=build row can carry plan_id: null.
    # Collapsing them would redirect a plan-less build's script log from the
    # global path into a NO_PLAN-scoped one — the sentinel is a ledger value,
    # never a plan-directory selector.
    _active_plan_id = extract_plan_id(script_args) or audit_plan_id
    _ledger_plan_id = _active_plan_id or NO_PLAN_SENTINEL

    script_path = resolve_notation(notation)
    if not script_path:
        handle_invalid_notation(notation, remaining_args)

    if not Path(script_path).exists():
        print(f"SCRIPT_ERROR\t{notation}\t1\tScript not found: {script_path}", file=sys.stderr)
        sys.exit(1)

    # Pre-spawn invocation validation. Runs AFTER notation resolution (so the
    # notation is known good) and BEFORE subprocess.run, so a provably invalid
    # call costs no process at all. `--audit-plan-id` was stripped from
    # `script_args` above and therefore never reaches the flag check — it is an
    # executor flag the target script has no reason to declare.
    #
    # Fail-open: `_validate_invocation` returns None both when the call is valid
    # and when the embedded surface cannot judge it, and both must dispatch.
    _rejection = _validate_invocation(notation, script_args)
    if _rejection is not None:
        _payload = _render_rejection_toon(notation, _rejection)
        # STDOUT, matching the canonical output contract: the caller reads the
        # correction from the same stream it reads every other result from.
        print(_payload)
        # Route the refusal through the SAME observability seams a real failure
        # takes, so a rejected dispatch is as visible in the logs as a crashed
        # one — an invisible rejection would be indistinguishable from a script
        # that simply produced no output.
        log_script_execution(
            notation=notation,
            subcommand=subcommand,
            args=_args_for_logging(script_args, audit_plan_id),
            exit_code=2,
            duration=0.0,
            stdout=_payload,
            stderr='',
        )
        emit_dispatch_failure_work_log(
            notation=notation,
            exit_code=2,
            stdout=_payload,
            stderr='',
            script_args=script_args,
            audit_plan_id=audit_plan_id,
        )
        # Exit 2 — the same code argparse itself uses for a rejected invocation,
        # so a caller branching on the exit code needs no new case.
        sys.exit(2)

    # Execute the script (with cleaned args, no --audit-plan-id)
    start = time.time()
    stdout_capture = ''
    stderr_capture = ''

    # Build environment with PYTHONPATH for cross-skill imports
    env = os.environ.copy()
    existing_pythonpath = env.get('PYTHONPATH', '')
    env['PYTHONPATH'] = _PYTHONPATH + (':' + existing_pythonpath if existing_pythonpath else '')
    # Export PLAN_DIR_NAME so scripts can use it for path construction
    # Use setdefault to respect existing value (e.g., set by test infrastructure)
    env.setdefault('PLAN_DIR_NAME', PLAN_DIR_NAME)

    # Suppress ANSI color in every fronted subprocess so downstream text
    # parsers receive plain output. Python 3.14's argparse --help colorizes
    # when can_colorize() allows it (consulting PYTHON_COLORS, then NO_COLOR,
    # then FORCE_COLOR); colored escapes corrupt option-flag parsers such as
    # plugin-doctor's manage-invocation analyzer. NO_COLOR overrides
    # FORCE_COLOR and PYTHON_COLORS=0 is the explicit override; popping
    # FORCE_COLOR is belt-and-suspenders. CLICOLOR/CLICOLOR_FORCE/PY_COLORS
    # pin the broader CLI surface (git/mvn/gradle/npm/pytest).
    env['PYTHON_COLORS'] = '0'
    env['NO_COLOR'] = '1'
    env.pop('FORCE_COLOR', None)
    env['CLICOLOR'] = '0'
    env['CLICOLOR_FORCE'] = '0'
    env['PY_COLORS'] = '0'

    try:
        # Capture output for logging (but still stream to console)
        result = subprocess.run(
            ['python3', script_path] + script_args,
            capture_output=True,
            text=True,
            env=env
        )
        exit_code = result.returncode
        stdout_capture = result.stdout
        stderr_capture = result.stderr

        # Stream output to console
        if result.stdout:
            print(result.stdout, end='')
        if result.stderr:
            print(result.stderr, end='', file=sys.stderr)

    except Exception as e:
        print(f"SCRIPT_ERROR\t{notation}\t1\t{str(e)}", file=sys.stderr)
        stderr_capture = str(e)
        exit_code = 1

    duration = time.time() - start

    # Build args for logging: inject --plan-id if audit_plan_id was provided
    # This allows log_script_execution to route to plan-specific log
    args_for_logging = _args_for_logging(script_args, audit_plan_id)

    # Log execution (skip for logging scripts on success to avoid meta-logging noise)
    if not should_skip_logging(notation, exit_code):
        log_script_execution(
            notation=notation,
            subcommand=subcommand,
            args=args_for_logging,
            exit_code=exit_code,
            duration=duration,
            stdout=stdout_capture if exit_code != 0 else '',
            stderr=stderr_capture if exit_code != 0 else ''
        )

    # Dispatch-boundary guard: every non-zero exit lands a single [ERROR] line
    # in the plan's work.log so caller-name drift, argparse rejections, and
    # script-internal failures stay visible without grepping
    # script-execution.log. See emit_dispatch_failure_work_log for the
    # recursion guard and the plan-id fallback chain.
    if exit_code != 0:
        emit_dispatch_failure_work_log(
            notation=notation,
            exit_code=exit_code,
            stdout=stdout_capture,
            stderr=stderr_capture,
            script_args=script_args,
            audit_plan_id=audit_plan_id,
        )

    # Build-class dispatch boundary: after every build-EXECUTING invocation,
    # append a kind=build entry to the unified change-ledger so the freshness
    # gate can ask "was this exact working-tree state built?". The predicate is
    # a CONJUNCTION - a build-* notation AND a build-executing subcommand - so a
    # query verb (or a bare --help, which carries no subcommand) writes no row:
    # it ran no build, and a row stamped for it would satisfy the freshness gate
    # without anything having been built. Records are appended unconditionally
    # on completion regardless of outcome; the stamped status
    # carries the truthful result (success/error/timeout/killed/unknown),
    # derived from the returncode and the wrapper's stdout TOON — the gate
    # requires status == 'success', and `unknown` (exit 0 with no
    # wrapper-claimable status on the payload) is deliberately not it.
    # The row's plan_id is `_ledger_plan_id` (script-arg
    # --plan-id or executor --audit-plan-id, falling back to the NO_PLAN
    # sentinel), so it is NEVER null; the log path keeps taking the
    # caller-supplied `_active_plan_id`, which stays None for a plan-less
    # build and therefore resolves to the GLOBAL script log rather than a
    # NO_PLAN-scoped one. The writer is fire-and-forget — see
    # _append_build_ledger_record.
    if _is_build_class_notation(notation, subcommand):
        # get_log_path raises from two sources: it rejects a malformed plan_id
        # with ValueError, and its global-fallback branch (the one a plan-less
        # build reaches, because `_active_plan_id` stays None there) mkdirs the
        # global log directory, which raises OSError when PLAN_BASE_DIR is not
        # writable (PermissionError, read-only filesystem, ENOSPC). This
        # resolution sits in an ARGUMENT position, outside
        # _append_build_ledger_record's fire-and-forget handler, and
        # `_active_plan_id` is unvalidated argv — so an unguarded call would
        # crash the executor AFTER the build ran, replacing the build's real
        # exit code with 1 and dropping the ledger row entirely. Ledger
        # bookkeeping is best-effort and must never mask a build result, so
        # resolve defensively against BOTH raise sources and fall back to an
        # empty log path.
        try:
            _ledger_log_file = str(get_log_path(_active_plan_id, 'script'))
        except (ValueError, OSError):
            _ledger_log_file = ''
        _append_build_ledger_record(
            notation=notation,
            plan_id=_ledger_plan_id,
            script_args=script_args,
            exit_code=exit_code,
            stdout=stdout_capture,
            log_file=_ledger_log_file,
        )

    sys.exit(exit_code)

if __name__ == '__main__':
    main()
