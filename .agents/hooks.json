{
  "plan-marshall-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .plan/execute-script.py plan-marshall:tools-script-executor:generate_executor --check-only",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
